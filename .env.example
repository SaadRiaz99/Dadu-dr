# Server
PORT=3000

# Change this! Password used to access /admin
ADMIN_PASSWORD=change-me

# Optional: PostgreSQL connection string.
# Leave unset to use the local data.json file.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: Telegram notifications (free).
# Create a bot with @BotFather and get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# Optional: Twilio SMS notifications.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+15005550000
# Phone number that receives new-appointment alerts.
NOTIFY_TO=+923001234567
