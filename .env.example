# Server
PORT=3000

# Change this! Password used to access /admin
ADMIN_PASSWORD=change-me

# Optional: PostgreSQL connection string.
# Leave unset to use the local data.json file.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Payment details shown to patients when they book.
JAZZCASH_NUMBER=03XX-XXXXXXX
EASYPAISA_NUMBER=03XX-XXXXXXX
# Bank transfer instructions shown on the booking page.
BANK_DETAILS=Ask the clinic for bank transfer details.

# Optional: Twilio SMS notifications.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+15005550000
# Phone number that receives new-appointment alerts.
NOTIFY_TO=+923001234567
